    <start>
        <locationX>314</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_The_Owner_A_Rep</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Routed_At__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>At_First_Response_Due</name>
            <connector>
                <targetReference>Get_Current_Lead</targetReference>
            </connector>
            <label>At First Response Due (SLA check)</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>First_Response_Due__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>EscalationBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!$Record.FirstName} {!$Record.LastName} at {!$Record.Company} was routed at {!$Record.Routed_At__c} and has not been contacted. First response was due {!$Record.First_Response_Due__c}. Routing: {!$Record.Routing_Reason__c}.</text>
    </textTemplates>
    <textTemplates>
        <name>EscalationTitle</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>SLA missed: {!$Record.Company} has had no reply</text>
    </textTemplates>
    <textTemplates>
        <name>NewLeadBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!$Record.FirstName} {!$Record.LastName} at {!$Record.Company} ({!$Record.Region__c}). Source: {!$Record.Inbound_Source__c}. Fit score: {!$Record.Fit_Score__c}. Why you: {!$Record.Routing_Reason__c}. Reply by {!$Record.First_Response_Due__c}.</text>
    </textTemplates>
    <textTemplates>
        <name>NewLeadTitle</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>New lead: {!$Record.Company} (fit {!$Record.Fit_Score__c})</text>
    </textTemplates>
    <textTemplates>
        <name>TaskSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>First response: {!$Record.FirstName} {!$Record.LastName}, {!$Record.Company}</text>
    </textTemplates>
