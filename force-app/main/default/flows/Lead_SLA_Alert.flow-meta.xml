    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Add_Owner_To_Recipients</name>
        <label>Add the owner to the recipient list</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <assignmentItems>
            <assignToReference>OwnerRecipients</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Notify_Owner</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Escalation_Recipients</name>
        <label>Add Lead Triage and the owner to the recipient list</label>
        <locationX>314</locationX>
        <locationY>947</locationY>
        <assignmentItems>
            <assignToReference>EscalationRecipients</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Triage_Queue.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>EscalationRecipients</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Notify_Triage_And_Owner</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_The_Owner_A_Rep</name>
        <label>Is the owner a rep (not a queue)?</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>No, the lead is waiting in a queue</defaultConnectorLabel>
        <rules>
            <name>Owner_Is_A_Rep</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>OwnerIsAUser</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_First_Response_Task</targetReference>
            </connector>
            <label>Yes, a rep owns it</label>
        </rules>
    </decisions>
    <decisions>
        <name>Still_Not_Contacted</name>
        <label>Still not contacted?</label>
        <locationX>446</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Contacted in time</defaultConnectorLabel>
        <rules>
            <name>Not_Contacted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Current_Lead.First_Touch_At__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Current_Lead.IsConverted</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Current_Lead.SLA_Escalated__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Lead_Escalated</targetReference>
            </connector>
            <label>Yes, escalate</label>
        </rules>
    </decisions>
    <description>Speed-to-lead SLA. When LeadRoutingService routes a lead to a rep: create a high-priority first-response task and send the rep a bell/mobile notification. When First Response Due arrives and nobody has touched the lead: tick SLA Escalated and notify the Lead Triage queue and the owner. Routing logic itself is in Apex; this Flow only handles the human-facing alerts.</description>
    <environments>Default</environments>
    <formulas>
        <name>OwnerIsAUser</name>
        <dataType>Boolean</dataType>
        <expression>LEFT({!$Record.OwnerId}, 3) = &quot;005&quot;</expression>
    </formulas>
    <interviewLabel>Lead SLA Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead SLA Alert and Escalation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_First_Response_Task</name>
        <label>Create a first-response task for the rep</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>Get_Notification_Type</targetReference>
        </connector>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>NewLeadBody</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsReminderSet</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ReminderDateTime</field>
            <value>
                <elementReference>$Record.First_Response_Due__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>TaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Current_Lead</name>
        <label>Get the lead as it is now</label>
        <locationX>446</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Still_Not_Contacted</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>First_Touch_At__c</queriedFields>
        <queriedFields>IsConverted</queriedFields>
        <queriedFields>SLA_Escalated__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Notification_Type</name>
