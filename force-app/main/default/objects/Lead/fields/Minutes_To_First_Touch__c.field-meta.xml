<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Minutes_To_First_Touch__c</fullName>
    <description>Minutes from Routed At to First Touch At.</description>
    <inlineHelpText>Minutes from Routed At to First Touch At.</inlineHelpText>
    <label>Minutes to First Touch</label>
